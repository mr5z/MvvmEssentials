<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Nkraft</Company>
    <Authors>Mark L</Authors>
    <Version>1.10.0-alpha.3</Version>
    <Copyright>Copyright (c) 2026 Mark L. All rights reserved.</Copyright>
    <Company>Nkraft</Company>
    <Description>MAUI's Shell Alternative</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/mr5z/MvvmEssentials</RepositoryUrl>
    <PackageReleaseNotes>Modals can hold several pages: ModalViewModel.PushAsync/PopAsync/ReplaceAsync navigate inside the modal, and any page of it can finish it with Dismiss(result). Popups and modals share PresentedViewModel; popups gain CanDismissAsync, and a background tap or Back now dismisses through the view model. Breaking: INavigationService relative navigation fails while a modal is open. See docs/migration.md.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/mr5z/MvvmEssentials</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <PackageReference Include="Nkraft.CrossUtility" Version="1.0.12.3" />
    <PackageReference Include="Nkraft.Mopups" Version="1.0.2.2" />
  </ItemGroup>
  
  <ItemGroup>
    <None Remove="SourceGenerator\**" />
    <None Include="Nkraft.MvvmEssentials.targets"
          Pack="true"
          PackagePath="buildTransitive/Nkraft.MvvmEssentials.targets" />
    <None Include="SourceGenerator\bin\$(Configuration)\netstandard2.0\Nkraft.MvvmEssentials.SourceGenerator.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);MVE001;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE">
      <Pack>True</Pack>
      <PackagePath />
    </None>
    <None Include="..\README.md" Link="README.md">
      <Pack>True</Pack>
      <PackagePath />
    </None>
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Remove="SourceGenerator\**" />
  </ItemGroup>

  <ItemGroup>
    <MauiCss Remove="SourceGenerator\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SourceGenerator\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="SourceGenerator\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="SourceGenerator\Nkraft.MvvmEssentials.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      Condition="'$(Configuration)' == 'Debug'" />
    <ProjectReference Include="SourceGenerator\Nkraft.MvvmEssentials.SourceGenerator.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      Condition="'$(Configuration)' != 'Debug'" />
  </ItemGroup>

</Project>
